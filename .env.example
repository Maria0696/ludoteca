# Copia este archivo como .env.local (desarrollo) o añade las variables en
# Vercel > Project > Settings > Environment Variables (producción).
# Sin las variables de Supabase la app funciona en modo local (solo este navegador).

# --- Supabase: base de datos y acceso (obligatorias para sincronizar) ---
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Correo de la única cuenta con acceso. Debe coincidir con el de app_owner
# en la base de datos (ver supabase/migrations/0001_biblioteca.sql).
OWNER_EMAIL=tu-correo@ejemplo.com

# --- IGDB: búsqueda de carátulas y datos (opcional, solo servidor) ---
# Twitch Developer Console > Applications > (tipo Confidential)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# --- Opcional ---
# Permite el modo local también en producción (no recomendado si es privada).
# ALLOW_LOCAL_MODE=true
